#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "================================================================"
echo "                    PRUSALAPSE PORTABLE (LINUX)                 "
echo "================================================================"
echo ""

# Find portable node runtime or system node
if [ -x "$SCRIPT_DIR/runtime/bin/node" ]; then
    NODE_BIN="$SCRIPT_DIR/runtime/bin/node"
elif [ -x "$SCRIPT_DIR/runtime/node" ]; then
    NODE_BIN="$SCRIPT_DIR/runtime/node"
elif command -v node >/dev/null 2>&1; then
    NODE_BIN="$(command -v node)"
else
    echo "[ERROR] No Node.js runtime found!"
    echo "Please ensure the runtime folder is present or install node (v18+)."
    exit 1
fi

# Locate server.js
if [ -f "$SCRIPT_DIR/app/server.js" ]; then
    SERVER_DIR="$SCRIPT_DIR/app"
elif [ -f "$SCRIPT_DIR/server.js" ]; then
    SERVER_DIR="$SCRIPT_DIR"
else
    echo "[ERROR] Could not find server.js!"
    exit 1
fi

export PORT="${PORT:-3000}"
export HOSTNAME="${HOSTNAME:-0.0.0.0}"
export NODE_ENV="production"

# Check bundled ffmpeg
if [ -x "$SCRIPT_DIR/bin/ffmpeg" ]; then
    export FFMPEG_PATH="$SCRIPT_DIR/bin/ffmpeg"
fi

echo "[INFO] Starting PrusaLapse server on port $PORT..."

# Launch background browser opener
(
    for i in $(seq 1 30); do
        sleep 0.5
        if curl -s "http://127.0.0.1:$PORT/api/config" >/dev/null 2>&1; then
            echo ""
            echo "================================================================"
            echo "  PrusaLapse is active and ready at: http://localhost:$PORT     "
            echo "  Opening browser now...                                        "
            echo "================================================================"
            echo ""
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "http://localhost:$PORT" >/dev/null 2>&1 || true
            elif command -v sensible-browser >/dev/null 2>&1; then
                sensible-browser "http://localhost:$PORT" >/dev/null 2>&1 || true
            fi
            break
        fi
    done
) &

cd "$SERVER_DIR"
exec "$NODE_BIN" server.js
