{
  "name": "prusalapse-desktop",
  "version": "1.3.0",
  "description": "PrusaLapse Cinematic Multi-Camera Timelapse Desktop Application",
  "author": "Carlos de la Fuente Bustillo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wl"
  },
  "build": {
    "appId": "com.prusalapse.desktop",
    "productName": "PrusaLapse",
    "copyright": "Copyright © 2026 Carlos de la Fuente Bustillo",
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "main.js",
      "icon.ico",
      "icon.png",
      "app/**/*",
      "bin/**/*"
    ],
    "asar": false,
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PrusaLapse",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PrusaLapse-Setup-${version}.${ext}",
      "uninstallDisplayName": "PrusaLapse"
    },
    "portable": {
      "artifactName": "PrusaLapse-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Graphics",
      "artifactName": "PrusaLapse-${version}-linux-x64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.7.0"
  }
}
